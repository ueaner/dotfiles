# vim: set filetype=sh:

# 避免同一 Shell 进程中重复加载环境变量
if [[ -n "${SHELL_ENV_LOADED:-}" ]]; then
    log
    return
fi
SHELL_ENV_LOADED=1

log "sourcing ~/.config/shell/env.d/[0-9][0-9]*.sh"

for envfile in ~/.config/shell/env.d/[0-9][0-9]*.sh; do
    # shellcheck disable=SC2086
    # shellcheck source=/dev/null
    . $envfile
done

log "sourced"

