#!/usr/bin/env bash
# DNF Utility Helper (Fedora 45+)
#
# dnf-util [-m <ustc|tsinghua|official>] [-r <all|fedora|rpmfusion>] [-x] [-c]
#
# Fedora 45 起，发行版提供的 repo 文件位于 /usr/share/dnf5/repos.d（由 rpm 管理），
# /etc/yum.repos.d 只保留管理员手动添加的仓库。因此镜像不再通过 sed 修改 repo 文件，
# 而是写入 dnf5 的仓库覆盖目录 /etc/dnf/repos.override.d，只覆盖 metalink/baseurl，
# 原始 repo 文件保持不变，软件包升级也不会产生 .rpmsave。

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
. "$SCRIPT_DIR/../lib/init"

help() {
    cat <<EOF
DNF Utility Helper (Fedora 45+)

Usage: dnf-util [options]

Show dnf summary (Default behavior when no other options)

    -m                       Mirror: ustc | tsinghua | official

    -r                       Repository: all (defaults) | fedora | rpmfusion

    -c                       Rewrite /etc/dnf/dnf.conf configuration contents

    -x                       Disable unused repositories

    -h                       Show this message

Mirror overrides are written to:

    $OVERRIDE_DIR/80-mirror-fedora.repo
    $OVERRIDE_DIR/80-mirror-rpmfusion.repo

Example:

    dnf-util -m ustc -r fedora
    dnf-util -m ustc -r all
    dnf-util -m ustc
    dnf-util -m ustc -x
    dnf-util -m tsinghua
    dnf-util -m official
    dnf-util
    dnf-util -m ustc -x -c

EOF
}

# 发行版 repo 文件目录与系统级仓库覆盖目录（见 man dnf5-config-manager）
VENDOR_REPO_DIR=/usr/share/dnf5/repos.d
OVERRIDE_DIR=/etc/dnf/repos.override.d

# 官方 baseurl 前缀（取自 vendor repo 文件中被注释的 #baseurl= 行）
FEDORA_UPSTREAM=http://download.example/pub/fedora/linux
RPMFUSION_UPSTREAM=http://download1.rpmfusion.org

# If a character is followed by a colon, it indicates that this specific option requires an argument.
OPTSTRING=":m:r:cxh"

mirror=
repo=
config=false
clean=false
no_option=true

defaults_dnfconf=$(
    cat <<EOF
[main]
gpgcheck=True
installonly_limit=2
clean_requirements_on_remove=True
best=False
skip_if_unavailable=True

exclude=kernel*
EOF
)

while getopts ${OPTSTRING} opt; do
    case ${opt} in
    m)
        mirror=$OPTARG
        if [[ "$mirror" != "ustc" && "$mirror" != "tsinghua" && "$mirror" != "official" ]]; then
            error "Argument must be one of [ustc | tsinghua | official]."
            exit 1
        fi
        no_option=false
        ;;
    r)
        repo=$OPTARG
        if [[ "$repo" != "all" && "$repo" != "fedora" && "$repo" != "rpmfusion" ]]; then
            error "Argument must be one of [all | fedora | rpmfusion]."
            exit 1
        fi
        no_option=false
        ;;
    c)
        config=true
        no_option=false
        ;;
    x)
        clean=true
        no_option=false
        ;;
    h)
        help
        exit 0
        ;;
    :)
        error "Option -${OPTARG} requires an argument."
        exit 1
        ;;
    ?)
        error "Invalid option: -${OPTARG}."
        exit 1
        ;;
    esac
done

shift $((OPTIND - 1))

# --- 版本检查：仅支持 Fedora 45+ ---
fedora_version=$(rpm -E %fedora)
if [[ ! "$fedora_version" =~ ^[0-9]+$ ]] || ((fedora_version < 45)); then
    error "dnf-util requires Fedora 45 or later (current: ${fedora_version})."
    exit 1
fi

# 未指定 -r 但指定了 -m 时，默认处理所有仓库
if [[ -n "$mirror" && -z "$repo" ]]; then
    repo=all
fi

# --- 参数逻辑检查 ---
if [[ -n "$repo" && -z "$mirror" && "$no_option" == false ]]; then
    # 如果指定了 repo 但没指定 mirror，且不是纯查询模式
    if [[ "$config" == false && "$clean" == false ]]; then
        error "Please specify a mirror (-m) for the repository (-r)."
        exit 1
    fi
fi

# 根据 vendor repo 文件生成镜像覆盖配置
# 对每个带有 "#baseurl=<upstream>..." 的仓库输出：
#   [repoid]
#   metalink=
#   baseurl=<mirror>...
# $1: 官方 baseurl 前缀  $2: 镜像 baseurl 前缀  $3...: vendor repo 文件
generate_mirror_override() {
    local upstream=$1 target=$2
    shift 2
    awk -v upstream="#baseurl=${upstream}" -v target="$target" '
        /^\[.*\]$/ { id = $0; next }
        index($0, upstream) == 1 && id != "" {
            printf "%s\nmetalink=\nbaseurl=%s%s\n\n", id, target, substr($0, length(upstream) + 1)
        }
    ' "$@"
}

# $1: fedora | rpmfusion  $2: 镜像站根地址（为空表示恢复官方 metalink）
apply_mirror() {
    local kind=$1 site=$2
    local override="$OVERRIDE_DIR/80-mirror-${kind}.repo"
    local upstream files=()

    if [[ -z "$site" ]]; then
        sudo rm -f "$override"
        return
    fi

    case "$kind" in
    fedora)
        upstream=$FEDORA_UPSTREAM
        files=("$VENDOR_REPO_DIR"/fedora.repo "$VENDOR_REPO_DIR"/fedora-updates*.repo)
        ;;
    rpmfusion)
        upstream=$RPMFUSION_UPSTREAM
        shopt -s nullglob
        files=("$VENDOR_REPO_DIR"/rpmfusion-*.repo)
        shopt -u nullglob
        ;;
    esac

    if ((${#files[@]} == 0)); then
        warn "No ${kind} repo files found in ${VENDOR_REPO_DIR}, skipped."
        return
    fi

    {
        echo "# Generated by dnf-util (mirror: ${site}). Do not edit manually."
        echo "# Run 'dnf-util -m official -r ${kind}' to restore official metalink."
        echo
        generate_mirror_override "$upstream" "${site}/${kind}" "${files[@]}"
    } | sudo tee "$override" >/dev/null
}

# --- 开始执行 ---
if [[ -n "$mirror" ]]; then
    task "Configuring DNF (Fedora)"
    info "Setting ${FG_MAGENTA}$repo${C_RESET} repositories mirror to ${FG_MAGENTA}$mirror${C_RESET}..."
fi

# --- RPM Fusion 安装 ---
if [[ "$repo" == "all" || "$repo" == "rpmfusion" ]]; then
    if ! rpm --quiet -q rpmfusion-free-release; then
        # https://rpmfusion.org/Configuration#Command_Line_Setup_using_rpm
        # https://rpmfusion.org/keys#Verify_GPG_signatures_on_install
        task "Installing RPM Fusion"
        sudo dnf install -y distribution-gpg-keys
        sudo rpmkeys --import "/usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-free-fedora-${fedora_version}"
        sudo rpmkeys --import "/usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-nonfree-fedora-${fedora_version}"
        sudo dnf install -y --setopt=localpkg_gpgcheck=1 \
            "https://mirrors.ustc.edu.cn/rpmfusion/free/fedora/rpmfusion-free-release-${fedora_version}.noarch.rpm" \
            "https://mirrors.ustc.edu.cn/rpmfusion/nonfree/fedora/rpmfusion-nonfree-release-${fedora_version}.noarch.rpm"

        sudo dnf config-manager setopt fedora-cisco-openh264.enabled=1
        success "RPM Fusion installed and GPG keys imported."
    fi
fi

# --- Mirror 切换 ---
if [[ -n "$mirror" ]]; then
    case "$mirror" in
    ustc)
        # https://mirrors.ustc.edu.cn/help/fedora.html
        # https://mirrors.ustc.edu.cn/help/rpmfusion.html
        site=https://mirrors.ustc.edu.cn
        step "Applying USTC mirrors..."
        ;;
    tsinghua)
        # https://mirrors.tuna.tsinghua.edu.cn/help/fedora/
        # https://mirrors.tuna.tsinghua.edu.cn/help/rpmfusion/
        site=https://mirrors.tuna.tsinghua.edu.cn
        step "Applying Tsinghua mirrors..."
        ;;
    official)
        site=
        step "Restoring official mirrors..."
        ;;
    esac

    sudo mkdir -p "$OVERRIDE_DIR"
    if [[ "$repo" == "all" || "$repo" == "fedora" ]]; then
        apply_mirror fedora "$site"
    fi
    if [[ "$repo" == "all" || "$repo" == "rpmfusion" ]]; then
        apply_mirror rpmfusion "$site"
    fi
    success "Mirror switched to ${mirror}."
fi

# --- DNF.conf 配置 ---
if $config; then
    task "Applying custom DNF policy"
    step "Locking kernel updates (exclude=kernel*)"
    echo "$defaults_dnfconf" | sudo tee /etc/dnf/dnf.conf >/dev/null
    success "Custom dnf.conf applied successfully."
fi

# --- 禁用无用 Repo ---
# 仓库文件可能位于 /etc/yum.repos.d 或 /usr/share/dnf5/repos.d，统一按 repo id 禁用
repo_exists() {
    dnf repo list --all 2>/dev/null | awk -v id="$1" '$1 == id { found = 1 } END { exit !found }'
}

if $clean; then
    task "Disabling unused repositories"
    unused_repos=(google-chrome "copr:copr.fedorainfracloud.org:phracek:PyCharm")
    if ! lspci | grep -q -i nvidia; then
        unused_repos+=(rpmfusion-nonfree-nvidia-driver)
    fi
    for id in "${unused_repos[@]}"; do
        if repo_exists "$id"; then
            sudo dnf config-manager setopt "${id}.enabled=0"
            step "Disabled ${id}"
        fi
    done
    success "Unused repositories disabled."
fi

if ! $no_option; then
    exit 0
fi

# --- Summary 部分 ---
section "DNF System Summary"

task "DNF Repolist"
sudo dnf repolist

task "Repository Status"
if dnf repo list --enabled 2>/dev/null | awk '$1 == "google-chrome" { found = 1 } END { exit !found }'; then
    warn "Google Chrome repo is still active."
else
    success "Third-party repos cleared."
fi

# 镜像状态检查
mirror_status() {
    local override="$OVERRIDE_DIR/80-mirror-$1.repo"
    if [[ ! -f "$override" ]]; then
        echo "${FG_GREEN}Official${C_RESET}"
    elif grep --quiet "^baseurl=.*ustc" "$override"; then
        echo "${FG_GREEN}USTC${C_RESET}"
    elif grep --quiet "^baseurl=.*tsinghua" "$override"; then
        echo "${FG_GREEN}Tsinghua${C_RESET}"
    else
        echo "${FG_YELLOW}Unknown${C_RESET} ($override)"
    fi
}
item "Current Fedora Mirror: $(mirror_status fedora)"
item "Current RPM Fusion Mirror: $(mirror_status rpmfusion)"

# RPM Fusion 检查
if rpm --quiet -q rpmfusion-free-release; then
    item "RPM Fusion: ${FG_GREEN}Installed${C_RESET}"
else
    item "RPM Fusion: ${FG_RED}Not Installed${C_RESET}"
fi

task "Current dnf.conf Content"
paragraph "$(cat /etc/dnf/dnf.conf)"

echo
echo "${C_DIM}--- End of Summary ---${C_RESET}"
